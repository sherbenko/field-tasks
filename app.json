{
  "expo": {
    "name": "Field Tasks",
    "slug": "field-tasks-sa-rn-7842",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3F5F4"
    },
    "android": {
      "package": "com.fieldtasks.sarn7842",
      "versionCode": 1,
      "permissions": [
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#176348"
      }
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#176348"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Field Tasks to attach photos to your work tasks.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withFieldTasksIcon"
    ]
  }
}
